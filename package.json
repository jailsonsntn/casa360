{
  "name": "casa360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "aab:release": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "mobile:apk:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/mobile-apk-dev.ps1",
    "mobile:apk:release": "powershell -ExecutionPolicy Bypass -File ./scripts/mobile-apk-release.ps1",
    "generate:icons": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-icons.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@supabase/supabase-js": "^2.97.0",
    "lucide-react": "0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
